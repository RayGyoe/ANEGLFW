		// ========== LinearLayout 测试 ==========
		
		/**
		 * 测试水平线性布局
		 */
		private function testLinearLayoutHorizontal():void
		{
			trace("[LayoutTestCase] 测试水平线性布局...");
			
			// 清空容器
			clearContainer();
			
			// 设置水平线性布局
			var layout:LinearLayout = new LinearLayout(LinearLayout.HORIZONTAL);
			layout.setSpacing(10);
			layout.setPadding(5, 5, 5, 5);
			_testContainer.setLayoutManager(layout);
			
			// 添加测试组件
			for (var i:int = 0; i < 3; i++)
			{
				_testContainer.addChild(_testComponents[i]);
			}
			
			// 验证布局结果
			var expectedX:Number = 5; // 左内边距
			for (i = 0; i < 3; i++)
			{
				var component:UIComponent = _testComponents[i];
				assertEquals("水平布局X坐标", expectedX, component.x);
				assertEquals("水平布局Y坐标", 5, component.y); // 上内边距
				
				expectedX += component.width + (i < 2 ? 10 : 0); // 宽度 + 间距
			}
			
			trace("[LayoutTestCase] 水平线性布局测试通过");
		}
		
