		/**
		 * 测试带权重的线性布局
		 */
		private function testLinearLayoutWithWeight():void
		{
			trace("[LayoutTestCase] 测试带权重的线性布局...");
			
			// 清空容器
			clearContainer();
			
			// 设置水平线性布局
			var layout:LinearLayout = new LinearLayout(LinearLayout.HORIZONTAL);
			layout.setSpacing(5);
			layout.setPadding(0, 0, 0, 0);
			_testContainer.setLayoutManager(layout);
			
			// 设置组件权重
			_testComponents[0]["layoutWeight"] = 1;
			_testComponents[1]["layoutWeight"] = 2;
			_testComponents[2]["layoutWeight"] = 1;
			
			// 添加测试组件
			for (var i:int = 0; i < 3; i++)
			{
				_testContainer.addChild(_testComponents[i]);
			}
			
			// 验证权重分配（第二个组件应该是其他组件的2倍宽度）
			var comp1Width:Number = _testComponents[0].width;
			var comp2Width:Number = _testComponents[1].width;
			var comp3Width:Number = _testComponents[2].width;
			
			// 权重比例应该是 1:2:1
			assertTrue("权重分配正确", Math.abs(comp2Width - comp1Width * 2) < 5);
			assertTrue("权重分配正确", Math.abs(comp1Width - comp3Width) < 5);
			
			trace("[LayoutTestCase] 带权重的线性布局测试通过");
		}
		
