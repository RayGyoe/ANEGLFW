		/**
		 * 测试边界布局自动/固定尺寸
		 */
		private function testBorderLayoutSizing():void
		{
			trace("[LayoutTestCase] 测试边界布局自动/固定尺寸...");
			
			// 清空容器
			clearContainer();
			
			// 设置边界布局，固定北区域高度
			var layout:BorderLayout = new BorderLayout();
			layout.setNorthHeight(50); // 固定北区域高度为50
			layout.setPadding(0, 0, 0, 0);
			_testContainer.setLayoutManager(layout);
			
			// 添加北区域和中心区域
			layout.addComponent(_testComponents[0], BorderLayout.NORTH);
			layout.addComponent(_testComponents[1], BorderLayout.CENTER);
			_testContainer.addChild(_testComponents[0]);
			_testContainer.addChild(_testComponents[1]);
			
			// 验证北区域高度被固定为50
			assertEquals("固定北区域高度", 50, _testComponents[0].height);
			
			// 验证中心区域位置和尺寸
			assertEquals("中心区域Y坐标", 50, _testComponents[1].y);
			assertEquals("中心区域高度", _testContainer.height - 50, _testComponents[1].height);
			
			trace("[LayoutTestCase] 边界布局自动/固定尺寸测试通过");
		}
		
		// ========== 辅助方法 ==========
		
		/**
		 * 清空测试容器
		 */
		private function clearContainer():void
		{
			// 移除所有子组件
			while (_testContainer.numChildren > 0)
			{
				_testContainer.removeChildAt(0);
			}
			
			// 清除布局管理器
			_testContainer.setLayoutManager(null);
			
			// 重置测试组件的属性
			for (var i:int = 0; i < _testComponents.length; i++)
			{
				var component:UIComponent = _testComponents[i];
				component.width = 60;
				component.height = 40;
				
				// 清除自定义属性
				if (component.hasOwnProperty("layoutWeight"))
					delete component["layoutWeight"];
				if (component.hasOwnProperty("gridRowSpan"))
					delete component["gridRowSpan"];
				if (component.hasOwnProperty("gridColumnSpan"))
					delete component["gridColumnSpan"];
				if (component.hasOwnProperty("borderRegion"))
					delete component["borderRegion"];
			}
		}
		
		/**
		 * 断言相等
		 * @param message 错误消息
		 * @param expected 期望值
		 * @param actual 实际值
		 */
		private function assertEquals(message:String, expected:Number, actual:Number):void
		{
			if (Math.abs(expected - actual) > 0.1)
			{
				throw new Error(message + ": 期望 " + expected + ", 实际 " + actual);
			}
		}
		
		/**
		 * 断言为真
