		// ========== BorderLayout 测试 ==========
		
		/**
		 * 测试基本边界布局
		 */
		private function testBorderLayoutBasic():void
		{
			trace("[LayoutTestCase] 测试基本边界布局...");
			
			// 清空容器
			clearContainer();
			
			// 设置边界布局
			var layout:BorderLayout = new BorderLayout();
			layout.setPadding(5, 5, 5, 5);
			_testContainer.setLayoutManager(layout);
			
			// 添加组件到不同区域
			layout.addComponent(_testComponents[0], BorderLayout.NORTH);
			layout.addComponent(_testComponents[1], BorderLayout.SOUTH);
			layout.addComponent(_testComponents[2], BorderLayout.WEST);
			layout.addComponent(_testComponents[3], BorderLayout.EAST);
			layout.addComponent(_testComponents[4], BorderLayout.CENTER);
			
			// 添加到容器
			for (var i:int = 0; i < 5; i++)
			{
				_testContainer.addChild(_testComponents[i]);
			}
			
			// 验证北区域位置（应该在顶部）
			assertEquals("北区域Y坐标", 5, _testComponents[0].y);
			assertEquals("北区域X坐标", 5, _testComponents[0].x);
			
			// 验证南区域位置（应该在底部）
			var expectedSouthY:Number = _testContainer.height - _testComponents[1].height - 5;
			assertEquals("南区域Y坐标", expectedSouthY, _testComponents[1].y);
			
			trace("[LayoutTestCase] 基本边界布局测试通过");
		}
		
