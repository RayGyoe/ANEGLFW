		/**
		 * 重写渲染方法
		 */
		protected override function doRender():void
		{
			if (!_shader || !_isLoaded) return;
			
			// 使用着色器程序
			_shader.useProgram();
			
			// 设置模型矩阵
			_modelMatrix.identity();
			_shader.setMatrix4fv("uModel", _modelMatrix);
			
			// 设置投影矩阵
			var uiManager:UIManager = UIManager.getInstance();
			_shader.setMatrix4fv("uProjection", uiManager.projectionMatrix);
			
			// 设置着色器参数和绘制图片
			with (Gl)
			{
				// 设置颜色（白色，不影响纹理）
				glUniform4f(glGetUniformLocation(_shader.program, "uColor"), 1.0, 1.0, 1.0, 1.0);
				
				// 设置透明度
				glUniform1f(glGetUniformLocation(_shader.program, "uAlpha"), _alpha);
				
				// 设置使用纹理
				glUniform1i(glGetUniformLocation(_shader.program, "uUseTexture"), 1);
				
				// 绑定纹理
				glActiveTexture(GL_TEXTURE0);
				glBindTexture(GL_TEXTURE_2D, uint(_texture));
				glUniform1i(glGetUniformLocation(_shader.program, "uTexture"), 0);
				
				// 绘制图片
				glBindVertexArray(uint(_VAO));
				glDrawArrays(GL_TRIANGLES, uint(0), uint(6));
				glBindVertexArray(uint(0));
				
				// 解绑纹理
				glBindTexture(GL_TEXTURE_2D, uint(0));
			}
		}
		
		/**
		 * 重写dispose方法
		 */
		public override function dispose():void
		{
			// 清理加载器
			if (_loader)
			{
				_loader.contentLoaderInfo.removeEventListener(Event.COMPLETE, onImageLoaded);
				_loader.contentLoaderInfo.removeEventListener(IOErrorEvent.IO_ERROR, onImageError);
				_loader.contentLoaderInfo.removeEventListener(IOErrorEvent.VERIFY_ERROR, onVerifyError);
				_loader = null;
			}
			
			// 清理位图数据
			if (_bitmapData)
			{
				_bitmapData.dispose();
				_bitmapData = null;
			}
			
			// 删除纹理
			if (_texture > 0)
			{
				Gl.glDeleteTextures(uint(1), _texture);
				_texture = 0;
			}
			
			super.dispose();
		}
		
		// 属性访问器
		public function get source():String { return _source; }
		public function set source(value:String):void
		{
			if (_source != value)
			{
				if (value && value.length > 0)
				{
					// 加载新图片
					loadImage(value);
					
					// 如果启用了自动尺寸，在图片加载完成后更新尺寸
					if (_autoSize && _isLoaded)
					{
						updateAutoSize();
					}
				}
				else
				{
					// 清空图片
					cleanupPreviousImage();
					_source = value || "";
					_needsRedraw = true;
				}
			}
		}
		
		public function get scaleMode():String { return _scaleMode; }
		public function set scaleMode(value:String):void
		{
			if (_scaleMode != value)
			{
				_scaleMode = value;
				updateTextureVertices();
				_needsRedraw = true;
			}
		}
		
		public function get smooth():Boolean { return _smooth; }
		public function set smooth(value:Boolean):void
		{
			if (_smooth != value)
			{
				_smooth = value;
				if (_isLoaded)
				{
					createTexture(); // 重新创建纹理以应用新的过滤设置
					_needsRedraw = true;
				}
			}
		}
		
		public function get isLoaded():Boolean { return _isLoaded; }
		public function get textureWidth():Number { return _textureWidth; }
		public function get textureHeight():Number { return _textureHeight; }
		
		// ========== 布局约束增强功能 ==========
		
		/**
		 * 获取组件的首选尺寸
		 * 根据图片原始尺寸和内边距自动计算
		 * @return 首选尺寸矩形
		 */
		public override function getPreferredSize():Rectangle
		{
			if (_autoSize && _isLoaded)
			{
				// 计算包含内边距的首选尺寸
				var prefWidth:Number = _textureWidth + _paddingLeft + _paddingRight;
				var prefHeight:Number = _textureHeight + _paddingTop + _paddingBottom;
				
				// 应用最小和最大尺寸限制
				prefWidth = Math.max(_minWidth, Math.min(_maxWidth, prefWidth));
				prefHeight = Math.max(_minHeight, Math.min(_maxHeight, prefHeight));
				
				return new Rectangle(0, 0, prefWidth, prefHeight);
			}
			
			// 如果不是自动尺寸，返回预设的首选尺寸
			return new Rectangle(0, 0, _preferredWidth, _preferredHeight);
		}
		
		/**
		 * 设置布局约束
		 * @param constraints 约束对象，可包含各种布局参数
		 */
		public function setLayoutConstraints(constraints:Object):void
		{
			if (!constraints) return;
			
			// BorderLayout约束
			if (constraints.hasOwnProperty("borderRegion"))
			{
				borderRegion = constraints.borderRegion;
			}
			
			// LinearLayout约束
			if (constraints.hasOwnProperty("layoutWeight"))
			{
				layoutWeight = constraints.layoutWeight;
			}
			
			// GridLayout约束
			if (constraints.hasOwnProperty("gridPosition"))
			{
				gridPosition = constraints.gridPosition;
			}
			else if (constraints.hasOwnProperty("row") || constraints.hasOwnProperty("col"))
			{
				// 支持直接设置行列
				gridPosition = {
					row: constraints.row || 0,
					col: constraints.col || 0,
					rowSpan: constraints.rowSpan || 1,
					colSpan: constraints.colSpan || 1
				};
			}
			
			// 尺寸约束
			if (constraints.hasOwnProperty("preferredWidth"))
			{
				_preferredWidth = constraints.preferredWidth;
			}
			if (constraints.hasOwnProperty("preferredHeight"))
			{
				_preferredHeight = constraints.preferredHeight;
			}
			if (constraints.hasOwnProperty("minWidth"))
			{
				_minWidth = constraints.minWidth;
			}
			if (constraints.hasOwnProperty("minHeight"))
			{
				_minHeight = constraints.minHeight;
			}
			if (constraints.hasOwnProperty("maxWidth"))
			{
				_maxWidth = constraints.maxWidth;
			}
			if (constraints.hasOwnProperty("maxHeight"))
			{
				_maxHeight = constraints.maxHeight;
			}
		}
		
		// ========== 自动尺寸相关属性访问器 ==========
		
		/**
		 * 设置是否启用自动尺寸
		 * @param value 是否启用自动尺寸
		 */
		public function set autoSize(value:Boolean):void
		{
			_autoSize = value;
			if (_autoSize && _isLoaded)
			{
				// 启用自动尺寸时，立即重新计算尺寸
				updateAutoSize();
			}
		}
		
		/**
		 * 获取是否启用自动尺寸
		 * @return 是否启用自动尺寸
		 */
		public function get autoSize():Boolean
		{
			return _autoSize;
		}
		
		/**
		 * 更新自动尺寸
		 */
		private function updateAutoSize():void
		{
			if (_autoSize && _isLoaded)
			{
				var preferredSize:Rectangle = getPreferredSize();
				width = preferredSize.width;
				height = preferredSize.height;
			}
		}
		
		/**
		 * 设置内边距
		 * @param left 左内边距
		 * @param top 上内边距
		 * @param right 右内边距
		 * @param bottom 下内边距
		 */
		public function setPadding(left:Number, top:Number, right:Number, bottom:Number):void
		{
			_paddingLeft = left;
			_paddingTop = top;
			_paddingRight = right;
			_paddingBottom = bottom;
			
			// 如果启用自动尺寸，重新计算
			if (_autoSize)
			{
				updateAutoSize();
			}
		}
		
		/**
		 * 获取内边距
		 * @return 内边距对象 {left, top, right, bottom}
		 */
		public function getPadding():Object
		{
			return {
				left: _paddingLeft,
				top: _paddingTop,
				right: _paddingRight,
				bottom: _paddingBottom
			};
		}
	}
}